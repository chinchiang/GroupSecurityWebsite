# Cybersecurity Governance & Operations Portal — Environment Example
# Copy to .env.local for local development. Never commit real secrets.

# Runtime
NODE_ENV=development

# Demo mode (always true for this MVP; production must use formal auth)
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth provider: "mock" | "oidc" (oidc not implemented in MVP)
AUTH_PROVIDER=mock

# Development-only demo session defaults (not secrets; no passwords)
# Role switcher overrides these in development only.
DEMO_DEFAULT_ROLE=employee
DEMO_DEFAULT_LOCALE=zh-TW

# Formal OIDC placeholders (unused in MVP — do not put real credentials here)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Feature flags (optional overrides)
FEATURE_REGULATORY_CLOCK=true
FEATURE_OT_SECURITY=true
FEATURE_PRODUCT_SECURITY=true
FEATURE_AI_SECURITY=true
FEATURE_SUPPLIER_RISK=true
